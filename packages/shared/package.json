{
  "name": "@sansu/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Kontrak bersama SANSU: enum domain, label, tipe respons API, identitas brand",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
