# ============================================================
#  Konfigurasi server SANSU (dipakai docker-compose.prod.yml)
#  deploy/install.sh membuat file .env ini otomatis dengan rahasia acak.
# ============================================================

# Alamat web Anda (arahkan DNS A-record domain ini ke IP server terlebih dulu)
DOMAIN=app.contoh.co.id
# Email untuk pemberitahuan sertifikat HTTPS (Let's Encrypt)
ACME_EMAIL=admin@contoh.co.id

# Rahasia — WAJIB acak & panjang (install.sh mengisinya otomatis). Jangan dibagikan.
POSTGRES_PASSWORD=ganti-password-database
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Pendaftaran perusahaan baru dari halaman login ("Coba gratis"): true / false
ALLOW_SIGNUP=true

# ---------- Pemilik layanan (Panel SANSU) ----------
# Email akun yang boleh membuka Panel SANSU (pisahkan dengan koma). Daftarkan akun dengan email ini lewat "Coba gratis".
PLATFORM_ADMIN_EMAILS=
# Kunci enkripsi token pihak ketiga. WAJIB di produksi (acak ≥ 32 karakter, berbeda dari JWT_SECRET): openssl rand -base64 48
# install.sh mengisinya otomatis. Jangan diubah setelah diisi; token yang sudah tersimpan tidak terbaca bila kuncinya berganti.
DATA_ENCRYPTION_KEY=
# PENTING: kunci ini juga mengenkripsi NIK, NPWP, dan nomor rekening di database. Kunci hilang/berganti = data itu TIDAK terbaca lagi.
# Simpan salinannya di tempat aman terpisah dari server (mis. pengelola kata sandi).
# Lama (hari) salinan cadangan database menyimpan data; ditampilkan ke klien saat meminta penghapusan data. Samakan dengan retensi backup di penyedia.
BACKUP_RETENTION_DAYS=

# ---------- Email (lupa sandi, verifikasi, tagihan) ----------
# Contoh Brevo (gratis 300 email/hari): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SANSU <no-reply@contoh.co.id>"
# Opsional: alamat balasan tetap (kosong = balasan ke pengirim)
MAIL_REPLY_TO=
# Wajib verifikasi email sebelum mengubah data (berlaku bila SMTP sudah diisi)
REQUIRE_EMAIL_VERIFICATION=true

# ---------- Pembayaran online langganan (opsional; tanpa ini = transfer manual) ----------
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---------- Sinkron marketplace (isi setelah disetujui sebagai partner/developer) ----------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SANDBOX=false
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
MARKETPLACE_SYNC_MINUTES=15

# ---------- Backup ----------
# Jam backup harian (WIB) & berapa banyak disimpan di server
BACKUP_TIME=01:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Kata sandi enkripsi backup offsite. SIMPAN DI TEMPAT AMAN — tanpa ini backup offsite tidak bisa dibuka.
BACKUP_PASSPHRASE=

# Salinan offsite ke object storage S3-compatible (IDCloudHost, Biznet Gio, Wasabi, Cloudflare R2, AWS S3, ...)
# Kosongkan RCLONE_REMOTE bila belum dipakai. Contoh: RCLONE_REMOTE=offsite:nama-bucket/sansu
RCLONE_REMOTE=
S3_PROVIDER=Other
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Peringatan ke Telegram (opsional, disarankan): backup gagal, error server, aplikasi mati/pulih, disk hampir penuh.
# Buat bot lewat @BotFather, chat id lewat @userinfobot. Uji di Panel SANSU → Sistem.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notifikasi persetujuan ke Telegram per pengguna (bot yang sama): nama bot tanpa @. Pengguna menghubungkan akunnya di Keamanan akun.
TELEGRAM_BOT_USERNAME=
# Peringatan disk bila pemakaian ≥ persen ini
DISK_ALERT_PCT=85
# Alamat email dukungan yang tampil di Pusat Bantuan (kosong = email admin layanan pertama)
SUPPORT_EMAIL=
