# Salin menjadi deploy/backup/backup.env lalu isi. JANGAN dimasukkan ke git dan jangan dibagikan (berisi kunci ke seluruh data).
# Format env-file Docker: NAMA=nilai, TANPA tanda kutip dan tanpa spasi di sekitar "=".

# Koneksi LANGSUNG Neon (bukan pooler; host tanpa "-pooler") dengan peran PEMILIK
DATABASE_URL=postgresql://neondb_owner:KATA_SANDI@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Kata sandi enkripsi backup (>= 16 karakter). Simpan salinannya di tempat terpisah.
BACKUP_PASSPHRASE=

# Tujuan salinan di luar penyedia (contoh Cloudflare R2). "offsite" harus persis begitu.
RCLONE_REMOTE=offsite:nama-bucket/sansu
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# Laporan ke Panel SANSU (token sama dengan BACKUP_REPORT_TOKEN di Railway)
BACKUP_REPORT_URL=https://alamat-aplikasi-anda/api/backup-report
BACKUP_REPORT_TOKEN=

SOURCE_LABEL=komputer-lokal
