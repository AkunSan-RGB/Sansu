{
  "name": "@sansu/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "jest",
    "test:e2e": "dotenv -e .env.test -- ts-node src/db/migrate.ts --reset && dotenv -e .env.test -- node --max-old-space-size=8192 ../node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "nest start --watch",
    "db:migrate:prod": "node dist/db/migrate.js",
    "storage:migrate": "ts-node src/db/migrate-storage.ts",
    "storage:migrate:prod": "node dist/db/migrate-storage.js",
    "load:serentak": "node scripts/uji-beban-serentak.mjs",
    "load:seed-air": "sh scripts/seed-beban-air.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@sansu/shared": "*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
