DATABASE_URL="postgresql://akurata:akurata@localhost:5434/akurata?schema=public"
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="12h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Email lewat Brevo API (HTTPS) — dipakai untuk SEMUA email aplikasi (lupa kata sandi, verifikasi, tagihan, pengingat).
# Wajib di hosting yang memblokir port SMTP (Railway paket gratis/Hobby). Isi dengan kunci Anda sendiri; JANGAN commit kunci asli.
# BREVO_SENDER_EMAIL harus alamat yang sudah diverifikasi di Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=""
BREVO_SENDER_NAME="SANSU"
BREVO_SENDER_EMAIL=""

# Row-level security (isolasi perusahaan di dasar database) aktif otomatis. Saklar darurat — hanya untuk diagnosis:
# RLS_DISABLED=true
# Mode satu layanan (Railway dll.): folder hasil build tampilan web yang disajikan API. Sudah diatur di deploy/railway/Dockerfile.
# WEB_DIST=/app/frontend/dist
